return function(t, loader)
	local PRNG = loader.shared("Util.PRNG")
	local Format = loader.shared("Util.Format")
	local RateLimiter = loader.shared("Util.RateLimiter")
	local Signal = loader.shared("Util.Signal")

	t.describe("PRNG", function()
		t.it("est déterministe pour une même graine", function()
			local a, b = PRNG.new(42), PRNG.new(42)
			for _ = 1, 50 do
				t.expect(a:next()).toBe(b:next())
			end
		end)
		t.it("diverge pour des graines proches", function()
			local a, b = PRNG.new(1), PRNG.new(2)
			local same = 0
			for _ = 1, 20 do
				if a:next() == b:next() then
					same += 1
				end
			end
			t.expect(same).toBeLessThan(3)
		end)
		t.it("reste dans les bornes", function()
			local rng = PRNG.new(7)
			for _ = 1, 500 do
				local v = rng:next()
				t.expect(v).toBeBetween(0, 0.9999999999)
				t.expect(rng:int(3, 5)).toBeBetween(3, 5)
			end
		end)
		t.it("fork produit des flux indépendants et reproductibles", function()
			local a = PRNG.new(9):fork("ville")
			local b = PRNG.new(9):fork("ville")
			local c = PRNG.new(9):fork("plots")
			t.expect(a:next()).toBe(b:next())
			t.expect(a:next() == c:next()).toBe(false)
		end)
		t.it("mélange sans perdre d'élément", function()
			local rng = PRNG.new(3)
			local list = rng:shuffle({ 1, 2, 3, 4, 5, 6 })
			table.sort(list)
			t.expect(list).toEqual({ 1, 2, 3, 4, 5, 6 })
		end)
	end)

	t.describe("Format", function()
		t.it("abrège les montants", function()
			t.expect(Format.money(0)).toBe("0")
			t.expect(Format.money(999)).toBe("999")
			t.expect(Format.money(1000)).toBe("1K")
			t.expect(Format.money(1500)).toBe("1.5K")
			t.expect(Format.money(12345)).toBe("12.3K")
			t.expect(Format.money(2500000)).toBe("2.5M")
			t.expect(Format.money(123456789)).toBe("123M")
			t.expect(Format.money(-4200)).toBe("-4.2K")
		end)
		t.it("formate les durées", function()
			t.expect(Format.duration(0)).toBe("0:00")
			t.expect(Format.duration(65)).toBe("1:05")
			t.expect(Format.duration(3725)).toBe("1h02")
		end)
	end)

	t.describe("RateLimiter", function()
		t.it("autorise jusqu'à la capacité puis refuse", function()
			local limiter = RateLimiter.new(3, 1)
			t.expect(limiter:allow("p1", 0)).toBe(true)
			t.expect(limiter:allow("p1", 0)).toBe(true)
			t.expect(limiter:allow("p1", 0)).toBe(true)
			t.expect(limiter:allow("p1", 0)).toBe(false)
			t.expect(limiter:allow("p2", 0)).toBe(true)
		end)
		t.it("se recharge avec le temps", function()
			local limiter = RateLimiter.new(2, 2)
			t.expect(limiter:allow("p", 0)).toBe(true)
			t.expect(limiter:allow("p", 0)).toBe(true)
			t.expect(limiter:allow("p", 0.1)).toBe(false)
			t.expect(limiter:allow("p", 0.6)).toBe(true)
		end)
		t.it("purge les seaux inactifs", function()
			local limiter = RateLimiter.new(1, 1)
			limiter:allow("a", 0)
			limiter:allow("b", 100)
			t.expect(limiter:prune(200, 150)).toBe(1)
		end)
	end)

	t.describe("Signal", function()
		t.it("appelle les connexions et respecte Disconnect / Once", function()
			local signal = Signal.new()
			local calls = {}
			local conn = signal:Connect(function(v)
				table.insert(calls, v)
			end)
			signal:Once(function(v)
				table.insert(calls, "once:" .. v)
			end)
			signal:Fire("a")
			signal:Fire("b")
			conn:Disconnect()
			signal:Fire("c")
			t.expect(calls).toEqual({ "a", "once:a", "b" })
		end)
	end)
end
